# A 1 ms tick: the node's loops pace in milliseconds.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The task watchdog resets a hung node.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
# More receive buffers: a frame is several universes and a sync in one burst.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_LWIP_UDP_RECVMBOX_SIZE=24
